{
  "id": "L004",
  "name": "CTA Pulse",
  "description": "Call-to-action ending screen with pulsing animation. Large text with emphasis effect. Best for video endings, follow prompts, subscription asks.",
  "template_file": "L004_template.tsx",
  "tags": ["cta", "ending", "call-to-action", "pulse", "subscribe"],
  "slots": [
    {
      "name": "mainText",
      "type": "text",
      "required": true,
      "description": "Main CTA text (e.g., 'Follow for more')"
    },
    {
      "name": "subText",
      "type": "text",
      "required": false,
      "description": "Secondary text below main CTA"
    },
    {
      "name": "emoji",
      "type": "text",
      "required": false,
      "default": "👇",
      "description": "Emoji to display (animates)"
    },
    {
      "name": "mainColor",
      "type": "color",
      "required": false,
      "default": "#FFD700",
      "description": "Color for main CTA text"
    },
    {
      "name": "pulseIntensity",
      "type": "number",
      "required": false,
      "default": 1.1,
      "description": "Scale factor for pulse animation (1.0 to 1.3)"
    }
  ],
  "timing": {
    "typical_duration": 3,
    "pulse_frequency": 1.5
  },
  "example_output": "Large centered text pulses gently. Emoji bounces. Creates urgency for action."
}
